# RouteX Recovery Twin — Server-Side AI Provider Configuration
# All keys remain strictly on the server side in your local .env (never committed, never exposed to browser)

# Primary AI Provider: Groq (Llama 3.3 / 3.1)
GROQ_API_KEY=

# Future AI Provider: Meta Llama API (Optional)
META_API_KEY=
META_API_ENDPOINT=https://api.llama-api.com/v1/chat/completions

# Future AI Provider: Muse API (Optional)
MUSE_API_KEY=
MUSE_API_ENDPOINT=

# Local Backend Port (Default: 3001)
PORT=3001
